@using BingoBoard.Admin.MauiHybrid.Components.Pages
@using BingoBoard.Admin.Shared.Pages
@using BingoBoard.Admin.Shared.Layout
<Router AppAssembly="typeof(MauiProgram).Assembly" NotFoundPage="typeof(NotFound)" AdditionalAssemblies="new[] { typeof(Home).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
